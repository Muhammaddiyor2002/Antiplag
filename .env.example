# Database
DATABASE_URL="postgresql://antiplag_user:antiplag_password@localhost:5432/antiplag?schema=public"
DB_PASSWORD="antiplag_password"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="please-generate-a-32-char-random-string-here"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Telegram Bot (optional, for login)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# OpenAI API (AI detector — optional, demo mode if empty)
OPENAI_API_KEY=""

# Google Custom Search (plagiat tekshirish — optional, demo mode if empty)
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_ENGINE_ID=""

# Email (SMTP — optional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@antiplag.uz"

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR="./public/uploads"

# App
APP_NAME="AntiPlag"
APP_URL="http://localhost:3000"
DEFAULT_LANGUAGE="uz"
